# ============================================================================
# HolidayTruce Backend Configuration
# ============================================================================
# Copy this file to .env and fill in actual values
# NEVER commit .env with real secrets to version control

# ============================================================================
# LLM Configuration (Anthropic Claude API)
# ============================================================================
# API key for Anthropic Claude API
# Get your key from: https://console.anthropic.com/
# Example: sk-ant-v7-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=your-api-key-here

# Claude model to use for AI features
# Available models: claude-3-opus-20250219, claude-3-sonnet-20250229, claude-3-haiku-20250307
# Default: claude-3-sonnet-20250229
ANTHROPIC_MODEL=claude-3-sonnet-20250229

# ============================================================================
# CORS Configuration
# ============================================================================
# Comma-separated list of allowed origins for frontend requests
# Example: https://app.toss.com,https://sandbox.toss.com
# NEVER allow * in production — be explicit about trusted frontends
CORS_ORIGINS=https://localhost:3000,https://example.com

# ============================================================================
# Server Configuration
# ============================================================================
# Port to listen on
# Default: 3000
# Railway deployments use PORT from environment automatically
PORT=3000
